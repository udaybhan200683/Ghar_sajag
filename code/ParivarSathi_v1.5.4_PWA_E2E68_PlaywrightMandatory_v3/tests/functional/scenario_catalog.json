    {
      "id": "door-open-daytime",
      "title": "Normal daytime door opening is green and explicit",
      "category": "expected",
      "requirements": [
        "F09",
        "F11"
      ],
      "steps": [
        {
          "action": "event",
          "node": "entry",
          "kind": "DOOR_OPEN"
        }
      ],
      "assertions": [
        {
          "path": "home.latest_activity.kind",
          "eq": "DOOR_OPEN"
        },
        {
          "path": "home.latest_activity.tone",
          "eq": "positive"
        },
        {
          "path": "home.latest_activity.details.unexpected",
          "eq": false
        }
      ]
    },
    {
      "id": "door-open-close-order",
      "title": "Door open and close remain chronological and explicit",
      "category": "expected",
      "requirements": [
        "F09",
        "F11"
      ],
      "steps": [
        {
          "action": "event",
          "node": "entry",
          "kind": "DOOR_OPEN"
        },
        {
          "action": "advance",
          "seconds": 60
        },
        {
          "action": "event",
          "node": "entry",
          "kind": "DOOR_CLOSED"
        }
      ],
      "assertions": [
        {
          "order": {
            "path": "home.recent_events",
            "field": "kind",
            "prefix": [
              "DOOR_CLOSED",
              "DOOR_OPEN"
            ]
          }
        },
        {
          "path": "home.door_status.state",
          "eq": "CLOSED"
        }
      ]
    },
