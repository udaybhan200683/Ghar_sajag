{
  "schema": 1,
  "release": "1.5.4",
  "description": "Single source of truth for host functional regression. Each case resets synthetic state and uses the same action/snapshot path as the web simulator.",
  "scenarios": [
    {
      "id": "motion-room1-visible",
      "title": "Room 1 motion is preserved as exact positive activity",
      "category": "expected",
      "requirements": [
        "F05",
        "F11"
      ],
      "steps": [
        {
          "action": "event",
          "node": "room1",
          "kind": "MOTION"
        }
      ],
      "assertions": [
        {
          "path": "home.latest_activity.kind",
          "eq": "MOTION"
        },
        {
          "path": "home.latest_activity.location",
          "eq": "room1"
        },
        {
          "path": "home.latest_activity.tone",
          "eq": "positive"
        }
      ]
    },
    {
      "id": "motion-kitchen-visible",
