{
  "id": "stream-late-night-door",
  "title": "Late-night door stays open then closes",
  "steps": [
    {"action": "event", "node": "entry", "kind": "DOOR_OPEN", "late_night": true},
    {"action": "advance", "seconds": 360},
    {"action": "event", "node": "entry", "kind": "DOOR_CLOSED"}
  ],
  "assertions": [
    {"select": "timeline", "where": {"kind": "DOOR_LEFT_OPEN", "tone": "danger"}, "count": 1},
    {"path": "home.latest_activity.kind", "eq": "DOOR_CLOSED"},
    {"path": "home.latest_activity.details.resolved_left_open", "eq": true}
  ]
}
