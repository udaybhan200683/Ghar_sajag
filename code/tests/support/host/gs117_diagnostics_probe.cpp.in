@HUB_RECEIVE@
void restore_owner_peers(){
@OWNER_LOOP@
}

void reset() {
    security_queue.reset();application_queue.reset();logs.clear();
    received_security_queue.clear();receive_diagnostic_queue.clear();
    g_security_queue=&queue_handles[0];g_data_queue=&queue_handles[1];
    g_control_queue=&queue_handles[0];g_health_queue=&queue_handles[1];
    g_gs117_receive_diagnostic_queue=&rx_queue_handles[0];
    peer_result=submit_result=readback_result=retune_result=0;
    adds=sends=last_wait=deleted=0;callback_mode=1;callback_offset=0;
    peer_exists=true;wrong_peer=peer_unknown=false;now_us=100000;
    security_receive_queue_accept=diagnostic_queue_accept=true;callback_channel=3;
    g_gs117_receive_sequence=0;g_gs117_receive_diagnostic_drops=0;
    g_radio_channel=actual_channel=3;g_security_phase=true;
#if GS117_SEND_DIAGNOSTICS
    g_diag_boot_session=123;g_diag_prior_callback_timeout=false;
#endif
}
bool logged(const char* value) {
    for(const auto& line:logs)if(line.find(value)!=std::string::npos)return true;
    return false;
}
int main(){try{
    NodeSecurityLink::Outbound out;out.destination={1,2,3,4,5,6};
    out.message.kind=security::wire::Kind::RejoinHello;out.message.body.assign(121,0x55);
    reset();bool submitted=false;
    check(send_security_message(out,true,&submitted)&&submitted&&sends==1&&last_wait==1000,"positive_behavior");
#if GS117_SEND_DIAGNOSTICS
    check(logged("stage=callback_positive")&&logged("tx=22")&&logged("boot_session=123 session=134"),"positive_evidence");
    check(logged("same_peer_window_no_txid"),"do_not_claim_transaction_correlation");
#else
    check(logs.empty(),"production_profile_diagnostics_disabled");
#endif
    reset();peer_exists=false;check(send_security_message(out)&&adds==1&&captured_peer.channel==0&&captured_peer.ifidx==WIFI_IF_STA&&!captured_peer.encrypt,"new_peer_behavior");
    reset();check(send_security_message(out)&&adds==0,"existing_peer_behavior");
    reset();peer_exists=false;peer_result=ESP_FAIL;check(!send_security_message(out)&&sends==0,"peer_failure_behavior");
#if GS117_SEND_DIAGNOSTICS
    check(logged("stage=peer_add")&&logged("peer_add=ESP_FAIL"),"peer_failure_stage");
    check(logged("peer_add_code=0xffffffff")&&logged("error_code=0xffffffff"),"exact_peer_error_code");
#endif
    reset();submit_result=ESP_FAIL;check(!send_security_message(out,true,&submitted)&&!submitted,"submission_failure_behavior");
#if GS117_SEND_DIAGNOSTICS
    check(logged("stage=esp_now_submit")&&logged("submit=ESP_FAIL"),"submission_stage");
    check(logged("submit_code=0xffffffff"),"exact_submission_error_code");
#endif
    reset();callback_mode=0;check(!send_security_message(out,true,&submitted)&&submitted,"negative_callback_behavior");
#if GS117_SEND_DIAGNOSTICS
    check(logged("stage=callback_negative")&&logged("cb_seen=1 cb_ok=0"),"negative_callback_evidence");
#endif
    reset();callback_mode=-1;check(!send_security_message(out)&&last_wait==1000,"timeout_behavior");
#if GS117_SEND_DIAGNOSTICS
    check(logged("stage=callback_timeout"),"timeout_evidence");
    callback_for(out.destination.data(),true);callback_mode=1;logs.clear();
    check(send_security_message(out)&&logged("pending_before_reset=1")&&logged("ambiguous_after_timeout"),"late_same_peer_ambiguity_not_hidden");
    reset();wrong_peer=true;check(send_security_message(out)&&logged("correlation=wrong_peer"),"wrong_peer_reported_without_changing_legacy_return");
    reset();peer_unknown=true;check(send_security_message(out)&&logged("correlation=peer_unknown"),"unknown_peer_reported");
    reset();callback_offset=-1000;check(send_security_message(out)&&logged("correlation=before_submit"),"old_callback_reported");
    reset();readback_result=ESP_FAIL;check(send_security_message(out)&&logged("actual_ch=0 channel_read=ESP_FAIL"),"readback_failure_does_not_change_send");
    reset();actual_channel=7;check(send_security_message(out)&&logged("requested_ch=3 actual_ch=7"),"channel_inconsistency_visible");
#endif
    reset();callback_mode=0;check(send_security_message(out,false)&&last_wait==0,"nonwaiting_submission_only");
    check(security_queue.has_value()&&!security_queue->accepted_by_radio,"nonwaiting_queue_preserved");
    reset();auto bad=out;bad.message.body.clear();check(!send_security_message(bad)&&sends==0,"fragment_failure_behavior");
#if GS117_SEND_DIAGNOSTICS
    check(logged("stage=wire_fragment"),"fragment_failure_evidence");
#endif
    reset();bad=out;bad.message.body.resize(300);check(!send_security_message(bad,false)&&sends==0,"nonwaiting_multifragment_guard");
    reset();gs::connectivity::IndiaWifiChannelDiscovery discovery;retune_result=ESP_FAIL;
    check(!send_rejoin_message(out,discovery)&&sends==0,"retune_failure_behavior");
#if GS117_SEND_DIAGNOSTICS
    check(logged("stage=channel_set"),"retune_failure_evidence");
#endif
#if defined(GS40_TEST_ONLY_CLOUDSYNC_BUILD) && GS40_TEST_ONLY_CLOUDSYNC_BUILD
    reset();ReceivedFrame rx;rx.size=133;rx.bytes[0]=0x47;rx.bytes[1]=0x53;rx.bytes[2]=1;rx.bytes[3]=6;rx.channel=3;
    std::optional<HubSecurityLink::Outbound> response;
    log_gs117_security_receive(rx,response);check(logged("state=security_owner_processed")&&logged("validation=no_response_unclassified"),"receive_is_not_authentication");
    response=out;response->message.kind=security::wire::Kind::RejoinChallenge;
    log_gs117_security_receive(rx,response);check(logged("validation=hello_authenticated_challenge_ready"),"authenticated_response_evidence");
    response->message.kind=security::wire::Kind::RejoinAck;
    log_gs117_security_receive(rx,response);check(logged("validation=rejoin_authenticated_ack_ready"),"authenticated_rejoin_ack_evidence");
    logs.clear();rx.size=2;log_gs117_security_receive(rx,response);check(logs.empty(),"malformed_header_never_trusted");

    reset();
    const std::uint8_t source_mac[6]={1,2,3,4,5,6};
    esp_now_recv_ctrl_t rx_control{3,-42};
    esp_now_recv_info_t rx_info{source_mac,&rx_control};
    const std::uint8_t hello[4]={0x47,0x53,1,6};
    receive_callback(&rx_info,hello,static_cast<int>(sizeof(hello)));
    check(logs.empty(),"receive_callback_does_not_log");
    check(received_security_queue.size()==1&&received_security_queue[0].gs117_rx_sequence==1,
          "security_callback_enqueued_with_sequence");
    drain_gs117_receive_diagnostics();
    check(logged("stage=callback_arrival")&&logged("stage=security_queue_enqueued")&&
          logged("rx_ch=3 rssi=-42 len=4 wire_kind=6"),"bounded_callback_and_queue_metadata");
    rx=received_security_queue[0];
    response=out;response->message.kind=security::wire::Kind::RejoinChallenge;
    log_gs117_security_dequeued(rx);
    check(logged("state=security_owner_dequeued")&&logged("rx_seq=1")&&
          logged("queue_delay_us="),"owner_dequeue_is_distinct_from_accept_processing");
    log_gs117_security_receive(rx,response);
    check(logged("rx_seq=1")&&logged("queue_delay_us="),"owner_processing_correlates_local_queue_sequence");

    reset();security_receive_queue_accept=false;
    receive_callback(&rx_info,hello,static_cast<int>(sizeof(hello)));
    drain_gs117_receive_diagnostics();
    check(logged("stage=security_queue_drop")&&received_security_queue.empty(),"security_queue_drop_visible");

    reset();receive_callback(nullptr,hello,static_cast<int>(sizeof(hello)));
    drain_gs117_receive_diagnostics();
    check(logged("stage=invalid_callback_input"),"invalid_callback_input_visible");

    reset();
    const std::uint8_t other_source[6]={9,9,9,9,9,9};
    esp_now_recv_info_t rejected_info{other_source,&rx_control};
    receive_callback(&rejected_info,hello,static_cast<int>(sizeof(hello)));
    drain_gs117_receive_diagnostics();
    check(logged("stage=source_rejected"),"rejected_source_distinguished");

    reset();
    const std::uint8_t unknown_frame[4]={0x47,0x53,9,6};
    receive_callback(&rx_info,unknown_frame,static_cast<int>(sizeof(unknown_frame)));
    drain_gs117_receive_diagnostics();
    check(logged("stage=unclassified_frame"),"unclassified_wire_frame_distinguished");

    reset();g_security_queue=nullptr;
    receive_callback(&rx_info,hello,static_cast<int>(sizeof(hello)));
    drain_gs117_receive_diagnostics();
    check(logged("stage=security_queue_unavailable"),"security_queue_unavailable_visible");

    reset();diagnostic_queue_accept=false;
    receive_callback(&rx_info,hello,static_cast<int>(sizeof(hello)));
    diagnostic_queue_accept=true;
    drain_gs117_receive_diagnostics();
    check(logged("state=diagnostic_loss")&&logged("dropped=2"),"diagnostic_telemetry_loss_visible");
    check(!logged("TOP_SECRET_AUTH_PAYLOAD"),"receive_diagnostics_do_not_log_payload");

    reset();
    for(unsigned i=0;i<10;++i)
        receive_callback(&rx_info,hello,static_cast<int>(sizeof(hello)));
    check(receive_diagnostic_queue.size()==16,"diagnostic_queue_is_fixed_bounded_capacity");
    drain_gs117_receive_diagnostics();
    check(logged("state=diagnostic_loss")&&logged("dropped=4"),"bounded_queue_overflow_is_reported");

    reset();
    std::atomic<bool> producers_done{false};
    std::thread owner_drain([&]{
        while(!producers_done.load(std::memory_order_acquire) ||
              !receive_diagnostic_queue_empty()) {
            drain_gs117_receive_diagnostics();
            std::this_thread::yield();
        }
    });
    std::vector<std::thread> callback_producers;
    for(unsigned producer=0;producer<4;++producer) {
        callback_producers.emplace_back([&]{
            for(unsigned event=0;event<2;++event)
                receive_callback(&rx_info,hello,static_cast<int>(sizeof(hello)));
        });
    }
    for(auto& producer:callback_producers) producer.join();
    producers_done.store(true,std::memory_order_release);
    owner_drain.join();
    std::array<bool,9> sequences_seen{};
    bool unique_sequences=true;
    for(const auto& frame:received_security_queue) {
        if(frame.gs117_rx_sequence==0 || frame.gs117_rx_sequence>=sequences_seen.size() ||
           sequences_seen[frame.gs117_rx_sequence]) unique_sequences=false;
        else sequences_seen[frame.gs117_rx_sequence]=true;
    }
    check(received_security_queue.size()==8 && unique_sequences,
          "concurrent_callback_sequences_are_unique_and_all_frames_enqueue");
    std::size_t arrival_count=0, enqueue_count=0;
    for(const auto& line:logs) {
        if(line.find("stage=callback_arrival")!=std::string::npos) ++arrival_count;
        if(line.find("stage=security_queue_enqueued")!=std::string::npos) ++enqueue_count;
    }
    check(arrival_count==8 && enqueue_count==8 &&
          g_gs117_receive_diagnostic_drops.load(std::memory_order_relaxed)==0,
          "concurrent_owner_drain_preserves_bounded_callback_evidence");
#else
    reset();
    const std::uint8_t production_source[6]={1,2,3,4,5,6};
    esp_now_recv_ctrl_t production_control{3,-42};
    esp_now_recv_info_t production_info{production_source,&production_control};
    const std::uint8_t production_hello[4]={0x47,0x53,1,6};
    receive_callback(&production_info,production_hello,
                     static_cast<int>(sizeof(production_hello)));
    check(received_security_queue.size()==1,"production_security_receive_behavior");
    check(receive_diagnostic_queue.empty()&&logs.empty(),
          "production_profile_has_no_gs117_receive_telemetry");
#endif
    reset();restore_owner_peers();check(deleted==0&&adds==0,"owner_existing_peer");
    reset();peer_exists=false;restore_owner_peers();check(deleted==0&&adds==1,"owner_new_peer");
    reset();peer_exists=false;peer_result=ESP_FAIL;restore_owner_peers();check(deleted==1,"owner_failed_peer");
    for(const auto& line:logs)check(line.find("TOP_SECRET_AUTH_PAYLOAD")==std::string::npos,"no_auth_payload_log");
    std::cout<<"GS117 RADIO DIAGNOSTICS checks="<<checks<<" PASS\n";
    return 0;
}catch(const std::exception& error){std::cerr<<error.what()<<"\n";return 1;}}
