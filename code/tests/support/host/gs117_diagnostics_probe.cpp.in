using esp_err_t = int;
using UBaseType_t = unsigned;
using QueueHandle_t = void*;
constexpr int ESP_OK=0, ESP_FAIL=-1, ESP_ERR_INVALID_SIZE=0x104,
    ESP_ERR_INVALID_ARG=0x102, ESP_ERR_TIMEOUT=0x107, WIFI_IF_STA=0,
    pdTRUE=1, kSendCallbackTimeoutMs=1000;
using wifi_second_chan_t = int;
enum esp_now_send_status_t { ESP_NOW_SEND_SUCCESS, ESP_NOW_SEND_FAIL };
struct esp_now_send_info_t { std::uint8_t* des_addr; const std::uint8_t* data; };
struct esp_now_recv_ctrl_t { std::uint8_t channel{}; std::int8_t rssi{-127}; };
struct esp_now_recv_info_t { const std::uint8_t* src_addr{}; esp_now_recv_ctrl_t* rx_ctrl{}; };
struct esp_now_peer_info_t {
    std::uint8_t peer_addr[6]{}; std::uint8_t channel{}; unsigned ifidx{}; bool encrypt{};
};
struct NodeSecurityLink {
    struct Outbound { std::array<std::uint8_t,6> destination{}; security::wire::Message message; };
};
struct HubSecurityLink { using Mac=std::array<std::uint8_t,6>; using Outbound=NodeSecurityLink::Outbound; };
struct ReceivedFrame {std::uint16_t size{};std::array<std::uint8_t,250> bytes{};
    std::array<std::uint8_t,6> source_mac{};std::uint8_t channel{};
    std::int8_t transport_rssi{-127};std::uint32_t gs117_rx_sequence{};
    std::uint64_t gs117_callback_us{};};
