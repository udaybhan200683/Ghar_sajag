std::atomic<bool> g_hil_logical_online{true};
std::atomic<unsigned> g_send_queue_drops{0};
int queue_handles[2]{};
void* g_security_send_queue=&queue_handles[0];
void* g_send_queue=&queue_handles[1];
void* g_security_queue=&queue_handles[0];
void* g_data_queue=&queue_handles[1];
void* g_control_queue=&queue_handles[0];
void* g_health_queue=&queue_handles[1];
