{
  "schema": 1,
  "scope": "implemented Phase 1 host-simulated PWA; Phase 2 Reports/Notifications and physical provisioning excluded",
  "rule_shape": "Each row defines GIVEN source, WHEN state/action, THEN required presentation, MUST_NOT forbidden presentation or side effects.",
  "components": {
    "home_banner": {"given": "care.alert, coverage.lost", "when": ["NORMAL", "CARE_CONCERN", "MONITORING_COVERAGE_LOST"], "then": ["Home looks normal + success", "Attention needed at home + danger"], "must_not": ["feature-specific concern detail", "battery maintenance alone changes banner"], "severity": ["success", "danger"], "css": "#homeTab .hero[data-severity]", "banner_change": "care concern only", "recent_change": false, "persistence": "derived", "reset": "normal", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "morning": {"given": "morning.status, sequence_started/completed, routine policy", "when": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "MISSED", "UNAVAILABLE"], "then": ["state-specific text", "success/green, warning/amber, danger/red, neutral respectively"], "must_not": ["door/night/battery concern", "IN_PROGRESS danger or overall attention by itself"], "severity": ["neutral", "warning", "success", "danger"], "css": "[data-care-card=morning][data-status][data-severity]", "banner_change": "MISSED only", "recent_change": "completion/miss where emitted", "persistence": "derived from backend", "reset": "COMPLETED in PASS fixture", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "iam_ok": {"given": "iam_ok.ok/status, simulator overdue concern, real OK_PRESSED", "when": ["NORMAL", "OVERDUE", "ACKNOWLEDGED"], "then": ["NORMAL confirmed, OVERDUE danger, ACKNOWLEDGED just confirmed", "acknowledgement newer than overdue event"], "must_not": ["door/night/battery/morning concern", "overdue remains after OK_PRESSED", "event chronology reversed", "offline press clears concern before backend acceptance"], "severity": ["success", "danger"], "css": "[data-care-card=ok][data-status][data-severity]", "banner_change": "OVERDUE", "recent_change": "acknowledgement/concern", "persistence": "simulator overdue flag is volatile; accepted OK_PRESSED is backend event", "reset": "confirmed", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "door": {"given": "door.open, open_for_s, left_open_alert, unexpected_alert, post_close_inactivity_alert", "when": ["CLOSED", "OPEN_WITHIN_LIMIT", "OPEN_TOO_LONG", "POST_CLOSE_INACTIVITY"], "then": ["Open/Closed", "elapsed backend duration when too long"], "must_not": ["night/battery/morning concern", "vague old duration when seconds available"], "severity": ["success", "danger"], "css": "[data-care-card=door].alert,.status-bad", "banner_change": "meaningful safety concern", "recent_change": "meaningful door events", "persistence": "backend event", "reset": "CLOSED", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "night": {"given": "night.bathroom_visits, common_visits, unusual, concern_text, thresholds", "when": ["NORMAL", "UNUSUAL_BATHROOM", "UNUSUAL_COMMON_ROOM"], "then": ["Bathroom/Common room count with singular/plural", "normal/unusual and domain-specific concern"], "must_not": ["main door/open/inactivity warning", "battery diagnostics", "morning concern"], "severity": ["success", "danger"], "css": "[data-care-card=night].alert,.status-bad", "banner_change": "UNUSUAL", "recent_change": "unusual activity event", "persistence": "backend count", "reset": "NORMAL", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "device_health": {"given": "device_health.low_name/percent/runtime/attention/offline_devices, coverage.lost, policy thresholds", "when": ["NORMAL", "LOW", "CRITICAL", "LOW_WITH_INSUFFICIENT_HISTORY", "LOW_WITH_RUNTIME_PREDICTION", "OFFLINE", "MONITORING_COVERAGE_LOST"], "then": ["affected device and battery %", "numeric backend runtime when available", "Collecting battery data only if unavailable", "Recharge now for low", "affected offline device", "Monitoring coverage lost when required-node lease expires"], "must_not": ["mAh/day", "confidence", "sample counts", "threshold internals", "door/night/morning concern", "battery-only overall attention"], "severity": ["neutral", "danger"], "css": "[data-care-card=device-health][data-severity]", "banner_change": "actual required-node coverage loss", "recent_change": "coverage loss/restoration events only; no battery maintenance event", "persistence": "battery history/health backend", "reset": "NORMAL", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "recent_important_events": {"given": "filtered backend timeline and care audit", "when": ["care event", "coverage lost/restored", "maintenance telemetry", "multiple events"], "then": ["meaningful events newest-first", "coverage loss/restoration classified by reason"], "must_not": ["battery percentage/runtime/consumption/confidence/threshold/raw diagnostic events", "generic coverage telemetry without loss/restoration reason"], "severity": ["event tone"], "css": ".timeline .event-pill", "banner_change": false, "recent_change": "care/safety events only", "persistence": "backend timeline", "reset": "deterministic PASS", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "devices_summary_list": {"given": "registered device registry + health + battery projection", "when": ["online", "offline", "low", "critical", "register", "edit", "unregister"], "then": ["total/active/inactive counts", "name/type/room/status/battery/runtime", "one row per registered device"], "must_not": ["unregistered row", "fabricated runtime", "mAh/day/confidence/mV/RF retry diagnostics", "unrelated care concern"], "severity": ["normal", "alert"], "css": "[data-device-id],.device-summary", "banner_change": "coverage loss only", "recent_change": "no maintenance telemetry", "persistence": "SQLite", "reset": "seven baseline devices", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "device_details": {"given": "foundation device row and retained last_seen/health history", "when": ["registered", "offline", "unregistered"], "then": ["identity/room/online status/last seen/battery where known", "simulated registration boundary"], "must_not": ["physical pairing success", "lost historical state after unregister", "mAh/day/confidence/mV/RF retry diagnostics", "another device data"], "severity": ["Online", "Offline"], "css": "#phase1Dialog .phase1-detail", "banner_change": false, "recent_change": false, "persistence": "SQLite", "reset": "baseline", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "settings_home": {"given": "foundation households", "when": ["load", "save", "cancel", "invalid save"], "then": ["saved name/timezone/locale after refresh/restart", "Not saved on rejection"], "must_not": ["unsaved value persisted", "false success toast"], "severity": ["normal", "error"], "css": "#homeDetailsForm,#phase1Error", "banner_change": false, "recent_change": false, "persistence": "SQLite", "reset": "synthetic default in test fixture", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "settings_family": {"given": "foundation family_members + actor role", "when": ["add", "edit", "deactivate", "cancel", "duplicate reject", "non-owner write"], "then": ["active/inactive role", "history retained", "owner-only mutation"], "must_not": ["last owner removal", "unauthorized write", "deactivated member silently deleted", "false success on rejection"], "severity": ["normal", "error"], "css": "#phase1Dialog .phase1-list", "banner_change": false, "recent_change": false, "persistence": "SQLite", "reset": "owner only", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "settings_manage_devices": {"given": "same foundation registry as Devices", "when": ["register", "edit", "unregister", "cancel", "duplicate reject"], "then": ["matching identity/room/count", "history retained"], "must_not": ["divergent duplicate registry", "last hub removal", "physical pairing claim", "false success on rejection"], "severity": ["normal", "error"], "css": "#phase1Dialog .phase1-list", "banner_change": false, "recent_change": false, "persistence": "SQLite", "reset": "baseline", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "settings_battery": {"given": "application_policy low/critical/drain fields", "when": ["load", "save", "invalid relationship"], "then": ["saved thresholds drive Device Health", "rejection shown"], "must_not": ["critical >= low", "unsaved policy applied", "care event on policy edit"], "severity": ["normal", "error"], "css": "#batteryForm,#phase1Error", "banner_change": false, "recent_change": false, "persistence": "SQLite", "reset": "defaults", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "settings_schedules": {"given": "versioned application_policy routine windows/thresholds", "when": ["load", "edit", "save", "reject", "cancel"], "then": ["editor stays attached during polling", "hub/backend policy version changes on save", "accepted values round-trip exactly", "rejection remains visible inline"], "must_not": ["lost draft during poll", "invalid policy applied", "false success on rejection", "cross-feature concern from editor alone"], "severity": ["normal", "error"], "css": "#scheduleEditor,#scheduleFeedback[data-save-feedback]", "banner_change": false, "recent_change": false, "persistence": "SQLite", "reset": "defaults", "viewports": ["chromium-desktop", "chromium-mobile"]},
    "settings_network": {"given": "network.hub_online/wan_online/provisioning", "when": ["view online", "view offline"], "then": ["truthful hub/WAN status", "hardware provisioning boundary"], "must_not": ["physical Wi-Fi pairing/provisioning success claim", "configuration mutation"], "severity": ["Online", "Offline"], "css": "#phase1Dialog", "banner_change": "coverage only", "recent_change": false, "persistence": "derived", "reset": "online", "viewports": ["chromium-desktop", "chromium-mobile"]}
  },
  "state_axes": {"morning": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "MISSED"], "door": ["CLOSED", "OPEN_WITHIN_LIMIT", "OPEN_TOO_LONG"], "night": ["NORMAL", "UNUSUAL_BATHROOM", "UNUSUAL_COMMON_ROOM"], "battery": ["NORMAL", "LOW", "CRITICAL", "LOW_WITH_INSUFFICIENT_HISTORY", "LOW_WITH_RUNTIME_PREDICTION"], "device_health": ["ONLINE", "OFFLINE", "MONITORING_COVERAGE_LOST"], "iam_ok": ["NORMAL", "OVERDUE", "ACKNOWLEDGED"]},
  "pairwise": [["door", "night"], ["door", "battery"], ["door", "morning"], ["night", "battery"], ["night", "morning"], ["morning", "battery"], ["offline", "battery"], ["ok", "door"], ["ok", "night"], ["ok", "battery"]],
  "high_risk_three_way": [["door", "night", "battery"], ["morning", "door", "night"]],
  "events": {"care_allowed": ["OK_PRESSED", "CALL_FAMILY", "MISSING_MORNING_ACTIVITY", "UNUSUAL_NIGHT_BATHROOM_ACTIVITY", "UNUSUAL_NIGHT_COMMON_ACTIVITY", "DOOR_LEFT_OPEN", "POST_DOOR_INACTIVITY", "DAYTIME_INACTIVITY", "COVERAGE_CHANGED:coverage_lost", "COVERAGE_CHANGED:coverage_restored"], "maintenance_forbidden": ["BATTERY_PERCENTAGE_UPDATE", "BATTERY_RUNTIME_RECALCULATION", "BATTERY_CONSUMPTION_RATE_UPDATE", "BATTERY_CONFIDENCE_UPDATE", "BATTERY_THRESHOLD_EVALUATION", "RAW_DEVICE_DIAGNOSTIC", "COVERAGE_CHANGED:diagnostic_without_loss_or_restoration"]},
  "simulator_actions": {"caregiver_pwa": ["morning", "ok", "door", "night", "battery", "reset_pass", "enable_browser_alerts"], "engineering_lab": ["reset", "advance", "event", "late_door", "wan", "clock", "node", "duplicate", "deadline", "notify", "fault", "clear_fault", "troubleshoot", "reboot", "settings", "claim", "acknowledge", "resolve", "run_suite", "export_log"]},
  "coverage": [
    {"requirement":"Home/banner + all unaffected cards; pairwise and 3-way", "domain":"functional scenario catalog", "api":"test_phase1_application.test_pairwise_and_three_way_backend_projection", "browser":"phase1_ui_contract.spec.ts interaction matrix", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Morning all implemented states + amber semantics", "domain":"host morning rules", "api":"test_pairwise_and_three_way_backend_projection; pwa_bridge_test", "browser":"phase1_ui_contract.spec.ts single-feature states", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Door closed/within/too long + elapsed", "domain":"functional scenario catalog", "api":"pwa_bridge_test; pairwise backend projection", "browser":"phase1_ui_contract.spec.ts; pwa_release_gate.spec.ts", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Night normal/bathroom/common + count grammar", "domain":"functional scenario catalog", "api":"pwa_bridge_test; pairwise backend projection", "browser":"phase1_ui_contract.spec.ts; pwa_release_gate.spec.ts", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Battery normal/critical/low runtime/history + offline name", "domain":"test_battery_analytics.py", "api":"test_phase1_application; pwa_bridge_test", "browser":"phase1_ui_contract.spec.ts; phase1_foundation.spec.ts", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"I am OK normal/concern/event acknowledgement", "domain":"functional scenario catalog", "api":"test_iam_ok_overdue_to_real_pressed_acknowledgement_preserves_other_domains; test_iam_ok_offline_press_waits_for_backend_acceptance", "browser":"phase1_ui_contract.spec.ts overdue -> accepted OK_PRESSED -> acknowledged, including delayed WAN delivery", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Important event classification/order + backend audit distinction", "domain":"backend timeline/analytics", "api":"test_maintenance_audit_is_retained_but_excluded_from_home_feed", "browser":"phase1_ui_contract.spec.ts feed projection", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Devices summary/list/detail/shared Manage Devices/retained unregister state", "domain":"test_foundation.py", "api":"test_device_application_path_history_and_simulation", "browser":"phase1_foundation.spec.ts", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Home Details/Family/Battery Alerts/Schedules durable + rejected saves", "domain":"test_foundation.py", "api":"test_phase1_application.py (including test_pwa_schedule_action_round_trips_exact_value)", "browser":"phase1_foundation.spec.ts save/reject/cancel/reload/forbidden-success", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Network status and no physical provisioning claim", "domain":"host network state", "api":"foundation/network", "browser":"phase1_foundation.spec.ts Network dialog", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"HW_REQUIRED"},
    {"requirement":"Monitoring coverage lost as an important event and banner concern", "domain":"required-node contact lease; COVERED -> UNKNOWN -> COVERED", "api":"test_required_node_coverage_loss_and_restoration_are_domain_and_care_events", "browser":"phase1_ui_contract.spec.ts required-node lease loss/recovery", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Active OWNER-only Settings mutations; family read-only", "domain":"FoundationService authorization", "api":"test_family_read_is_allowed_but_owner_only_mutations_are_denied", "browser":"not applicable: Phase 1 local PWA has fixed simulation-owner actor, no identity switch", "positive":true, "forbidden":true, "desktop":false, "mobile":false, "status":"AUTOMATED"},
    {"requirement":"Normal persistence vs isolated fixture/order independence", "domain":"FoundationService reset_test_fixture", "api":"test_test_fixture_isolated_but_normal_restart_is_durable; test_daytime_inactivity_then_offline_missing_is_order_independent", "browser":"phase1_foundation.spec.ts refresh flows", "positive":true, "forbidden":true, "desktop":true, "mobile":true, "status":"AUTOMATED"},
    {"requirement":"Occupied port immediate setup diagnostic", "domain":"runner pre-bind", "api":"test_playwright_runner.py", "browser":"not applicable", "positive":true, "forbidden":true, "desktop":false, "mobile":false, "status":"AUTOMATED"},
    {"requirement":"Selective visual baselines", "domain":"not applicable", "api":"not applicable", "browser":"failure screenshots only; semantic checks primary", "positive":false, "forbidden":false, "desktop":true, "mobile":true, "status":"PARTIAL"},
    {"requirement":"Reports/production notification delivery", "domain":"not implemented", "api":"not implemented", "browser":"not implemented", "positive":false, "forbidden":false, "desktop":false, "mobile":false, "status":"PHASE2_PENDING"}
