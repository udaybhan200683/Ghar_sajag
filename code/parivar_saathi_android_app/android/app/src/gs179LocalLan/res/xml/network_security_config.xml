<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- This CA is included only in the debug TEST_ONLY source set. The app
                 still requires a matching DNS/IP SAN and its WebView pins one exact
                 configured origin before any request is allowed. -->
            <certificates src="@raw/gs179_local_lan_test_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
