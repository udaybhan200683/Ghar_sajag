<resources>
    <style name="Theme.ParivarSaathi" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#166F54</item>
        <item name="android:statusBarColor">#F5FBF7</item>
        <item name="android:navigationBarColor">#F5FBF7</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ParivarSaathi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/parivar_saathi_splash_wordmark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.ParivarSaathi</item>
    </style>
</resources>
