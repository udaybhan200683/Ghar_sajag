{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghar-sajag.example/contracts/cloud-event-v1.json",
  "title": "Ghar Sajag cloud event v1",
  "type": "object",
  "required": ["schema", "home_id", "event_id", "kind", "occurred_at", "hub_received_at"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "home_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "kind": {"type": "string", "minLength": 1, "maxLength": 32},
    "location": {"type": "string", "maxLength": 32},
    "occurred_at": {"type": "integer", "minimum": 0},
    "hub_received_at": {"type": "integer", "minimum": 0},
    "uncertainty_s": {"type": "integer", "minimum": 0, "maximum": 86400},
    "is_test": {"type": "boolean"},
    "payload": {"type": "object"}
  }
}
