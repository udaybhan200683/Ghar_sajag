# Explicit CH343 UART0 TEST_ONLY control profile. The canonical builder adds
# this override only when the registered fixture descriptor identifies that
# UART bridge. Native USB COM10 must retain the existing USB receiver profile.
CONFIG_ESP_TLS_USE_DS_PERIPHERAL=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
# The protected GS40 TEST_ONLY RSA-3072 bootstrap has a compile-time 8 KiB
# main-task stack requirement. Keep this override limited to the fixture profile.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
