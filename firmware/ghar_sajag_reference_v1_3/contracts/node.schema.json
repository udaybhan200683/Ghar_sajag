{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghar-sajag.example/contracts/node-event-v1.json",
  "title": "Ghar Sajag node event v1",
  "type": "object",
  "required": ["schema", "source_id", "session_id", "sequence", "kind", "location", "monotonic_ms"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 32},
    "session_id": {"type": "integer", "minimum": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["MOTION", "DOOR_OPEN", "DOOR_CLOSED", "OK_PRESSED", "CALL_FAMILY", "HEARTBEAT", "PRIVACY_ON", "PRIVACY_OFF", "GAP"]},
    "location": {"type": "string", "minLength": 1, "maxLength": 32},
    "monotonic_ms": {"type": "integer", "minimum": 0},
    "event_age_ms": {"type": "integer", "minimum": 0},
    "battery_mv": {"type": "integer", "minimum": 0, "maximum": 6000},
    "is_test": {"type": "boolean"}
  }
}
