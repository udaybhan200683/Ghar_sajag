// Measurement-only callback: verify accepted size-fixture prefix after failed load.
// No authenticated history serializer or new storage implementation.
void short_prefix_restart(nvs_handle_t& h,const esp_partition_t* part,
                          const std::vector<unsigned>& sizes,unsigned loaded) {
    for(unsigned i=0;i<loaded;++i)REQUIRE(offline_verify(h,"o",i,sizes[i],0));
    nvs_close(h);REQUIRE(nvs_flash_deinit_partition(part_name)==ESP_OK);
    REQUIRE(nvs_flash_init_partition_ptr(part)==ESP_OK);
    REQUIRE(nvs_open_from_partition(part_name,"life",NVS_READWRITE,&h)==ESP_OK);
    for(unsigned i=0;i<loaded;++i)REQUIRE(offline_verify(h,"o",i,sizes[i],0));
    using namespace compact_sdk;
    Store adapter;adapter.protected_space=true;
    PublicationPlan lower;lower.ordinary_admission=true;
    lower.blobs={531,4000,Transaction::head_bytes};
    lower.control_manifest_bytes=control_manifest_bound(1);
    lower.event_objects_after=1;lower.reducer_objects_after=1;
    REQUIRE(workspace(lower).required_free_pages==15);
    const auto wb=esp_partition_get_write_bytes(),eb=esp_partition_get_erase_ops();
    for(unsigned attempt=0;attempt<3;++attempt){
        REQUIRE(!adapter.prepare_publication(lower));
        REQUIRE(adapter.outcome==SpaceOutcome::InsufficientProtectedSpace);
        REQUIRE(adapter.writes==0&&esp_partition_get_write_bytes()==wb&&esp_partition_get_erase_ops()==eb);
    }
    std::printf("SHORT_PREFIX_RECOVERY loaded_objects=%u byte_verified=1 restart=PASS certified_pages=%zu required_pages=%zu reject_writes=0 ack_eligible=0 attempts=3 authenticated_history=NOT_IMPLEMENTED\n",loaded,adapter.certified_free,adapter.reservation.required_free_pages);
    metric("short_recovered",loaded,part);
}


