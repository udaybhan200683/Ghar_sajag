        'address':hex(s['sh_addr'])} for s in sections if s['sh_flags']&2 and s['sh_size']]
    rows=[];ram_rows=[];unique=set()
    for symbol in symtab.iter_symbols():
        index=symbol['st_shndx'];size=symbol['st_size'];kind=symbol['st_info']['type']
        if not isinstance(index,int) or not size or kind not in ('STT_FUNC','STT_OBJECT'):continue
        section=sections[index]
        if not section['sh_flags']&2:continue
        signature=(symbol['st_value'],size)
        if signature in unique:continue
        unique.add(signature)
        row={'symbol':symbol.name,'bytes':size,'section':section.name,'kind':kind,'address':hex(symbol['st_value'])}
        if section['sh_type']=='SHT_PROGBITS':rows.append(row)
        if section.name in ('.dram0.bss','.dram0.data','.iram0.text','.iram0.vectors'):
            ram_rows.append(row)
    names=[row['symbol'] for row in rows+ram_rows]
    demangled=subprocess.check_output([str(TOOL/'xtensa-esp32-elf-c++filt'),*names],text=True).splitlines()
    for row, name in zip(rows+ram_rows,demangled):row['name']=name
    asset=symtab.get_symbol_by_name('node_firmware_bin')[0]
    rows.append({'symbol':asset.name,'name':asset.name,'bytes':symtab.get_symbol_by_name('_binary_node_firmware_bin_end')[0]['st_value']-asset['st_value'],
        'section':sections[asset['st_shndx']].name,'kind':'KNOWN_EMBEDDED_NOTYPE','address':hex(asset['st_value'])})
    report['top30_flash_symbols']=sorted(rows,key=lambda x:x['bytes'],reverse=True)[:30]
    report['top20_static_ram_symbols']=sorted(ram_rows,key=lambda x:x['bytes'],reverse=True)[:20]
    # Count absence using retained executable/data symbol tables, not build lists.
    all_names=[s.name for s in symtab.iter_symbols()]
    report['symbol_searches']={term:[n for n in all_names if term in n][:20] for term in
        ('boost','iostream','basic_ostream','basic_stringstream','__cxa_throw','__dynamic_cast',
         '_binary_x509','node_firmware_bin','hil_log_state','hil_control','esp_http_client','esp_https_ota')}
    templates=[row for row in rows if row['symbol'].startswith(('_ZNSt','_ZNKSt','_ZSt','_ZN9__gnu_cxx','_ZNK9__gnu_cxx'))]
    report['cpp_template_total_named_bytes']=sum(row['bytes'] for row in templates)
    report['cpp_template_symbol_bytes']={term:sum(row['bytes'] for row in templates if term in row['name'])
        for term in ('std::vector','std::map','std::deque','std::__cxx11::basic_string','std::_Rb_tree')}
with open('/tmp/gs-hub-ram-layout.o','rb') as f:
    elf=ELFFile(f);symbol=elf.get_section_by_name('.symtab').get_symbol_by_name('audit_sizes')[0]
    data=elf.get_section(symbol['st_shndx']).data()[symbol['st_value']:symbol['st_value']+symbol['st_size']]
    names=('ReceivedFrame','StaticQueue_t','DomainEvent','InventoryRecord','InventorySnapshot','RecoveryState',
           'HubRuntime','HubSecurityLink','RetirementReportReassembler','FotaOwnerCommand','FotaOwnerAck','std::string')
    report['xtensa_type_sizes']=dict(zip(names,struct.unpack('<'+'I'*len(names),data)))
disassembly=subprocess.check_output([str(TOOL/'xtensa-esp32-elf-objdump'),'-dC',str(BUILD/'gs_hw_m1_hub.elf')],text=True)
frames={m[1]:int(m[2],0) for m in re.finditer(r'^[0-9a-f]+ <([^\n]+)>:\n[^\n]*entry\s+a1,\s+(0x[0-9a-f]+|[0-9]+)',disassembly,re.M)}
report['recovery_frames']={name:size for name,size in frames.items() if any(t in name for t in
    ('secure_owner_task(void*)','HubDurabilityOwner::recover','HubDurabilityOwner::initialize_epoch_one','DurableStore::checkpoint','DurableStore::recover')) and 'lambda' not in name and name.startswith('gs::')}
report['top_stack_frames']=sorted([{'function':name,'entry_frame':size} for name,size in frames.items()],key=lambda x:x['entry_frame'],reverse=True)[:12]
blocks=re.split(r'(?m)^(?=[0-9a-f]+ <)',disassembly)
hooks=[b for b in blocks if 'secure_owner_task(void*)::{lambda()' in b.split('\n',1)[0] and '::_FUN()>' in b.split('\n',1)[0]]
assert len(hooks)==1 and '<vTaskDelay>' in hooks[0] and re.search(r'movi(?:\.n)?\s+a10, 1',hooks[0])
report['manual_recovery_hook_check']='PASS vTaskDelay(1); existing test FAILS on movi versus movi.n encoding assertion'
report['recovery_hook_disassembly']=hooks[0]
