report['retained_components']=sorted(components)
report['compiled_only_components']=sorted(set(description['build_components'])-set(components))
report['provenance']={'project_version':description['project_version'],'build_path':str(BUILD),
    'sdkconfig':artifact(Path('/tmp/gs-hub-footprint-1c3727d/sdkconfig.baseline')),
    'embedded_node':artifact(Path('/tmp/gs-hub-footprint-1c3727d/code/ParivarSathi_v1.5.4_PWA_BatteryAnalytics_v3_4_2/firmware/hub/target/esp32/idf/main/node_firmware.bin'))}
Path('/tmp/gs-hub-footprint-audit.json').write_text(json.dumps(report,indent=2)+'\n')
