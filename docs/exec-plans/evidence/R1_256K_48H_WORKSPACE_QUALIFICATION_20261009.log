from pathlib import Path
import argparse,hashlib,os,re,subprocess,tempfile
p=argparse.ArgumentParser();p.add_argument('--binary',type=Path,required=True);p.add_argument('--output',type=Path,required=True);a=p.parse_args()
with a.output.open('w') as log:
 def emit(s):print(s,file=log,flush=True)
 emit('SDK_BINARY_SHA256='+hashlib.sha256(a.binary.read_bytes()).hexdigest())
 emit('FIXTURE_SHA256='+hashlib.sha256(Path('/tmp/gs-workspace48-fixture.txt').read_bytes()).hexdigest())
 for cut in (None,0,1,8,999999):
  with tempfile.TemporaryDirectory(prefix='gs-workspace48-cov-') as scratch:
   env=os.environ.copy();env.update(GS_PEAK='1',GCOV_PREFIX=scratch)
   env['LD_LIBRARY_PATH']='/tmp/gs-ruby/usr/lib/x86_64-linux-gnu:/tmp/gs-libbsd-dev/usr/lib/x86_64-linux-gnu'
   if 'san' in str(a.binary):env.update(ASAN_OPTIONS='detect_leaks=0:halt_on_error=1',UBSAN_OPTIONS='halt_on_error=1')
   cmd=[str(a.binary.resolve()),'workspace48','/tmp/gs-workspace48-fixture.txt']+([] if cut is None else [str(cut)])
   emit('COMMAND='+' '.join(cmd));r=subprocess.run(cmd,env=env,text=True,capture_output=True,timeout=60)
   emit(r.stdout.rstrip());emit(r.stderr.rstrip());emit('EXIT='+str(r.returncode))
   assert r.returncode==0 and 'WORKSPACE48_COUNTEREXAMPLE_PASS' in r.stdout
   if cut in (0,1,8):assert 'child_exit=77' in r.stdout and 'COMPACT_POWER_CUT' in r.stdout
   if cut==999999:assert 'child_exit=0' in r.stdout
   for name in re.findall(r'^EMULATOR_IMAGE=(/tmp/idf-partition-[A-Za-z0-9]+)$',r.stderr,re.M):Path(name).unlink(missing_ok=True)
 emit('FOCUSED_WORKSPACE_TESTS_PASS=5; QUALIFICATION_RESULT=FAIL_CAPACITY for frozen retained map + current certificate; not end-to-end qualification')
print('LOG='+str(a.output))
