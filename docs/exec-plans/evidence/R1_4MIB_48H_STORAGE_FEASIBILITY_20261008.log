"""Bounded measurement only: existing deterministic prefix, unchanged ledger/SDK."""
from pathlib import Path
from dataclasses import replace
import hashlib,importlib.util,json,os,re,subprocess,sys,tempfile
ROOT=Path('/home/udaybhan/projects/Ghar_sajag_r1_storage')
TMP=Path('/tmp/gs-r1-48h-e548fed')
PRODUCT=ROOT/'code/ParivarSathi_v1.5.4_PWA_BatteryAnalytics_v3_4_2'
SOURCE=PRODUCT/'host/storage/offline_72h_model.py'
BINARY=PRODUCT/'host/storage/nvs_runtime_probe/build/gs_nvs_runtime_probe.elf'
spec=importlib.util.spec_from_file_location('offline_model',SOURCE)
m=importlib.util.module_from_spec(spec);sys.modules[spec.name]=m;spec.loader.exec_module(m)
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
report={'head':'e548fedb7ecf59a4e2d0b201a3100c07eb6b35df','context':'2026-10-08.002',
        'model_sha256':sha(SOURCE),'sdk_binary_sha256':sha(BINARY),
        'sdk_commit':'76f5dedd9950a3012fee8fb7d5586df21fc67802','cloud_acknowledgments':0,
        'prefix_policy':'unchanged 72h timeline truncated at source-time cutoff; same six last-source anchors re-applied; no rate rescaling; fixed four-day and recovery budgets unchanged',
        'rows':[],'sdk_48h':[]}
with (TMP/'measure.log').open('w') as log:
 def emit(x):
  print(x,file=log,flush=True)
  print(x,flush=True)
 emit('INPUTS='+json.dumps({k:v for k,v in report.items() if k not in ('rows','sdk_48h')}))
 for scenario in ('NORMAL','HIGH'):
  for profile in ('mixed','ordinary'):
   full=m.workload(m.RATES[scenario],profile)
   for hours in (72,48):
    end=43200+hours*3600
    events=[e for e in full if e.at<end]
    if hours==48:
     # Match workload() anchoring exactly: final source event for each Node,
     # before the separately appended origin=4 local outcomes.
     for node in range(6):
      i=max(i for i,e in enumerate(events) if e.node==node and e.origin in (1,2))
      events[i]=replace(events[i],safety=True)
    assert len(events)==m.RATES[scenario]*hours//24+hours//3
    exact,summaries=m.summarize(events)
    represented={e.key for e in exact}
    for summary in summaries:
     assert not represented.intersection(summary.sources)
     represented.update(summary.sources)
     summary.encode()
    assert represented=={e.key for e in events}
    required={e.key for e in events if e.safety or e.kind not in ('motion','source_summary')}
    assert required<={e.key for e in exact}
    assert all(e in exact for e in events if e.kind=='source_summary')
    for worst in (True,False):
     row=m.ledger(events,worst=worst)
     row.update(scenario=scenario,profile=profile,hours=hours,worst=worst,inputs=len(events),
                source_events=m.RATES[scenario]*hours//24,local_outcomes=hours//3,
                retained_pending_sources=len(represented),cloud_acknowledgments=0,
                logical_all_object_bytes=sum(row['object_sizes']))
     if hours==72 and profile=='mixed':
      expected={('NORMAL',True):282624,('NORMAL',False):147456,('HIGH',True):745472,('HIGH',False):225280}
      assert row['protected_peak_bytes']==expected[scenario,worst]
     fixture=TMP/f'{scenario}-{profile}-{hours}h-{"max" if worst else "typical"}.txt'
     fixture.write_text(f"{row['history_segments']} {row['cow_segments']} {2*row['reserve_events']//32} {row['inputs']}\n"+'\n'.join(map(str,row['object_sizes']))+'\n')
     row['fixture_sha256']=sha(fixture);row['fixture_path']=str(fixture)
     report['rows'].append(row)
     emit('MODEL='+json.dumps({k:v for k,v in row.items() if k not in ('object_sizes','boundary')}))
 # Only four NEW worst-size 48h SDK cases; established 72h outcomes reused.
 # Capacity mode retains all history blobs; it removes only candidate/temporary
 # metadata after verified updates. No backend accept/backfill/schedule mode.
 for row in report['rows']:
  if row['hours']!=48 or row['profile']!='mixed' or not row['worst']:continue
  for pages in (32,64):
   with tempfile.TemporaryDirectory(prefix='gs-r1-48h-cov-') as scratch:
    env=os.environ.copy();env.update(GS_DIAG_PAGES=str(pages),GS_PEAK='1',GCOV_PREFIX=scratch,
                                    GS_EMULATOR_FLASH_BYTES='4194304')
    env['LD_LIBRARY_PATH']='/tmp/gs-ruby/usr/lib/x86_64-linux-gnu:/tmp/gs-libbsd-dev/usr/lib/x86_64-linux-gnu'+(':'+env['LD_LIBRARY_PATH'] if env.get('LD_LIBRARY_PATH') else '')
    command=[str(BINARY),'offline',row['fixture_path']]
    emit('SDK_CASE='+json.dumps({'scenario':row['scenario'],'hours':48,'pages':pages,'fixture_sha256':row['fixture_sha256'],'command':command}))
    result=subprocess.run(command,env=env,text=True,capture_output=True,timeout=60,cwd=PRODUCT/'host/storage/nvs_runtime_probe')
    emit(result.stdout.rstrip());emit(result.stderr.rstrip());emit('EXIT='+str(result.returncode))
    assert result.returncode in (0,2,3)
    if result.returncode:assert 'OFFLINE_STOP' in result.stdout
    else:assert 'OFFLINE_PASS' in result.stdout
    report['sdk_48h'].append({'scenario':row['scenario'],'hours':48,'partition_bytes':pages*4096,'fixture_sha256':row['fixture_sha256'],
                             'exit':result.returncode,'stdout':result.stdout,'stderr':result.stderr,
                             'history_pinned':True,'backend_acknowledgments':0})
    # Match existing runner: remove only completed child's precisely emitted image.
    for name in re.findall(r'^EMULATOR_IMAGE=(/tmp/idf-partition-[A-Za-z0-9]+)$',result.stderr,re.M):
     Path(name).unlink(missing_ok=True)
 emit('SEMANTIC_LEDGER_CHECKS=PASS; all sources retained, exact important/native summaries, no backend ACKs')
 emit('NEW_SDK_CASES=4; hardware and authenticated aggregate integration UNQUALIFIED')
(TMP/'measurements.json').write_text(json.dumps(report,indent=2)+'\n')
